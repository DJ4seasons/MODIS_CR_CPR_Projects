def bin_file_read2mtx(fname,dtype=np.float32):
    """ Open a binary file, and read data
        fname : file name
        dtp   : data type; np.float32 or np.float64, etc. """

    if not os.path.isfile(fname):
        print("File does not exist:"+fname)
        sys.exit()

    with open(fname,'rb') as fd:
        bin_mat = np.fromfile(file=fd,dtype=dtype)

    return bin_mat

from math import ceil
def lon_deg2x(lon,lon0,dlon):
    x=ceil((lon-lon0)/dlon)
    if lon0<0 and lon>180:
        x-= int(360/dlon)
    if lon0>0 and lon<0:
        x+= int(360/dlon)

    return x
lat_deg2y = lambda lat,lat0,dlat: ceil((lat-lat0)/dlat)

def get_tgt_latlon_idx(latlons, tgt_lats, tgt_lons):
    lon0,dlon,nlon= latlons['loninfo']
    lat0,dlat,nlat= latlons['latinfo']
    ##-- Regional index
    if isinstance(tgt_lons,(list,tuple,np.ndarray)):
        lon_idx= [lon_deg2x(ll,lon0,dlon) for ll in tgt_lons]
        if lon_idx[0]==lon_idx[1]:
            if tgt_lons[0]!=tgt_lons[1]:
                lon_ids= np.arange(nlon)+lon_idx[0]
                lon_ids[lon_ids>=nlon] -= nlon
            else:
                lon_ids= np.array([lon_idx,])
        elif lon_idx[1]<lon_idx[0]:
            lon_ids= np.arange(lon_idx[0]-nlon,lon_idx[1],1)
        else:
            if lon_idx[1]-lon_idx[1]<nlon and tgt_lons[1]-tgt_lons[0]>360:
                lon_idx[1]+=int(360/dlon)   
            lon_ids= np.arange(lon_idx[0], lon_idx[1], 1)
    else:
        lon_ids= np.arange(nlon,dtype=int)
    lat_idx= [lat_deg2y(ll,lat0,dlat) for ll in tgt_lats]
    return lat_idx, lon_ids

def quarter_slide_sampling(arr,t_wnd,h_wnd,anomaly=False):
    ## It is assumed that arr is of 4-D [nyr,t_prd,nlat1,nlon1]
    nyr,t_prd,nlat1,nlon1= arr.shape
    if arr.min()<-99.:
        print('Check data')
        sys.exit()
        
    out_data=[]
    for iy in range(nlat1-h_wnd+1):
        for ix in range(nlon1-h_wnd+1):            
            for it in range(0,t_prd-t_wnd+1,t_wnd//4):
                tmp_arr= arr[:,it:it+t_wnd,iy:iy+h_wnd,ix:ix+h_wnd].mean(axis=(1,2,3))
                
                if anomaly:
                    tmp_arr= tmp_arr-tmp_arr.mean()
                out_data.append(tmp_arr)
    
    out_data= np.asarray(out_data).T
    return out_data
    
def read_ERA5_1deg_yearly(vn,tgt_year):
    indir= '/home/djin1/data10/Sat_obs/ERA5/MODIS_matched/MODIS_resol/'
    data_range= (date(2002,7,1), date(2022,11,30))
    dr_names= [dd.strftime('%Y%m%d') for dd in data_range]
    ndays= (data_range[1]-data_range[0]).days+1
    nlat,nlon= 120,360
    
    fn_header= indir+'ERA5_{}.LocalNoon_6hrs-mean+1deg_60S-60N.'.format(vn)
    fn= fn_header+'{}-{}_{}x{}x{}.f32dat'.format(*dr_names,ndays,nlat,nlon)
    
    tgt_dates= (date(tgt_year-1,9,1), date(tgt_year,8,31))
    ndy= (tgt_dates[1]-tgt_dates[0]).days+1
    itidx= (tgt_dates[0]-data_range[0]).days
    offset= 4*nlon*nlat*itidx
    data= np.memmap(fn,mode='r',dtype=np.float32,offset=offset,shape=(ndy,nlat,nlon))
    tmp_data= np.array(data)
    if np.any(tmp_data<-999):
        print('Possible Missing',vn,tgt_year,tmp_data.min())

    print(tgt_year,tmp_data.shape)
    return tmp_data

